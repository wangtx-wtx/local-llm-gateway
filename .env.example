# ============ Local LLM Gateway configuration ============
# Copy this file to .env and adjust. All values are optional;
# sensible local-first defaults apply.

# --- Server ---
# Bind address. Default 127.0.0.1 (loopback only). Set 0.0.0.0 to expose.
LOCAL_GATEWAY_HOST=127.0.0.1
# Port. Default 8317.
LOCAL_GATEWAY_PORT=8317
# SQLite database file. Default ./data/gateway.db
LOCAL_GATEWAY_DB_PATH=./data/gateway.db

# --- Security ---
# Gateway API key required from AI clients (Authorization: Bearer ... or x-api-key).
# If unset: /v1 endpoints accept unauthenticated requests on loopback binds only.
#
# IMPORTANT: the gateway refuses to start on a non-loopback LOCAL_GATEWAY_HOST
# unless BOTH LOCAL_GATEWAY_API_KEY and LOCAL_GATEWAY_ADMIN_PASSWORD are set.
# LOCAL_GATEWAY_API_KEY=

# Admin dashboard password, sent as the `x-admin-password` header (there is no
# separate login endpoint — each admin request is authenticated on its own).
# If unset: the admin UI/API is accessible from this host only (loopback client
# address), and any other client is rejected.
# LOCAL_GATEWAY_ADMIN_PASSWORD=

# Master encryption key for API key secrets (AES-256-GCM), base64 or hex, 32 bytes.
# If unset, a random key is generated and stored in ./data/master.key (chmod 600).
# LOCAL_GATEWAY_MASTER_KEY=

# --- Behaviour ---
# Log level: DEBUG | INFO | WARN | ERROR. Default INFO.
LOCAL_GATEWAY_LOG_LEVEL=INFO
# Persist INFO+ logs to the `logs` table for the dashboard. Default true.
LOCAL_GATEWAY_PERSIST_LOGS=true
# Default upstream request timeout in ms (headers). Default 120000.
LOCAL_GATEWAY_REQUEST_TIMEOUT_MS=120000
# TCP connect timeout in ms for upstream connections. Default 15000.
LOCAL_GATEWAY_CONNECT_TIMEOUT_MS=15000
# Default stream idle timeout in ms. Default 120000.
LOCAL_GATEWAY_STREAM_IDLE_TIMEOUT_MS=120000
# Default provider concurrency. Default 16.
LOCAL_GATEWAY_MAX_CONCURRENT_REQUESTS=16
# Default max queued acquires per semaphore. Default 256.
LOCAL_GATEWAY_MAX_QUEUE_SIZE=256
# Hard cap on request body size in bytes. Default 32 MiB.
LOCAL_GATEWAY_MAX_BODY_BYTES=33554432
# Hard deadline for a single upstream attempt, in ms. Default 600000.
# Retries and fallbacks each start a fresh attempt with its own deadline.
LOCAL_GATEWAY_TOTAL_DEADLINE_MS=600000
